# .buildignore — patterns excluded from release tarballs by scripts/build-release.sh.
#
# Passed to `rsync --exclude-from` when staging server/ and scripts/ into the
# tarball. Patterns are relative to each rsync source root, not the repo root,
# so `data/` matches server/data/ (any `data/` directory at any depth).
# See rsync(1) FILTER RULES for syntax.

# Dev database and local state — would leak dev credentials and audit log
# contents into every shipped tarball. All of server/data/ is never-ship.
data/
*.db
*.db-wal
*.db-shm
analytics.duckdb*
ipam.db

# Credentials and TLS material — belt-and-suspenders. These should be kept
# out of server/ at all times, but the exclusion catches stray dev artifacts
# if someone ever drops a key into the source tree. `*.crt` is deliberately
# NOT excluded because the minisign public key file `cidrella.pub` needs to
# ship, but TLS certs belong in /var/lib/cidrella/certs/ anyway.
*.env
.env
.env.local
.env.production
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
credentials
secrets

# Test scaffolding — not needed at runtime
tests/
vitest.config.js

# Dev-only scripts — users can't usefully run these on a production box.
# NOTE: this is an explicit-name exclusion list. If a new dev script is added
# in the future, it must be added here or it will silently ship. Longer-term,
# the scripts/ staging should probably invert to an allowlist (ship only
# install.sh, rollback.sh, cidrella-node, cidrella-dnsmasq-hup, cidrella.pub,
# lib/, sudoers/, systemd/). Tracked in PLAN.md backlog.
build-release.sh
deploy-lxc.sh
test-dns-blocking.sh

# Dev-only source files that don't belong in production. The api-browser
# route is also gated at mount time by NODE_ENV !== 'production' in
# server/src/index.js, but excluding the file here means an admin can't
# enable it in a shipped install even by monkey-patching index.js.
routes/api-browser.js

# Python bytecode cache from server/anomaly/
__pycache__/
*.pyc
*.pyo

# Logs, backups, editor and OS debris
*.log
*.bak
*.tmp
.DS_Store
Thumbs.db
.vscode/
.idea/

# Dependencies — already handled by the build pipeline (server/node_modules
# is cleaned and re-installed via `npm ci --omit=dev` later), but excluded
# here as belt-and-suspenders so the dev tree's node_modules never
# accidentally makes it into staging.
node_modules/
