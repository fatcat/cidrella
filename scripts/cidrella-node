#!/bin/sh
# CIDRella node resolver — prefers a bundled runtime if present,
# falls back to the system node binary. Installed at
# /usr/local/bin/cidrella-node and used by:
#   - cidrella.service (ExecStart, via server/src/launcher.js)
#   - update.sh (when operating on the active slot)
#   - rollback.sh
#
# Phase 0 (v0.4.3): bundled runtime does not exist yet — this wrapper
# is plumbing for Phase 2 (v0.4.5), which will ship a pinned Node.
# Until then, every call falls through to /usr/bin/node.
#
# Resolution order:
#   1. $CIDRELLA_NODE (explicit override for testing)
#   2. /opt/cidrella/runtime/node/bin/node (bundled, via active symlink)
#   3. /usr/bin/node  (Debian/Ubuntu default)
#   4. /usr/local/bin/node (manually installed)
#   5. `node` from PATH (last resort)

set -eu

# Resolve $0 and $CIDRELLA_NODE to canonical paths so a self-reference
# (CIDRELLA_NODE=/usr/local/bin/cidrella-node when this script IS that
# path) is detected and skipped. Without the guard, calling this wrapper
# with CIDRELLA_NODE set to itself produces a tight exec() loop with no
# output — the exact trap that the v0.4.15 cidrella-reset-password
# wrapper fell into. readlink -f resolves symlinks; if readlink is
# missing we still fall through to the candidate list below.
if [ -n "${CIDRELLA_NODE:-}" ] && [ -x "${CIDRELLA_NODE}" ]; then
  _self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  _override="$(readlink -f "$CIDRELLA_NODE" 2>/dev/null || echo "$CIDRELLA_NODE")"
  if [ "$_self" != "$_override" ]; then
    exec "${CIDRELLA_NODE}" "$@"
  fi
fi

for candidate in \
  /opt/cidrella/runtime/node/bin/node \
  /usr/bin/node \
  /usr/local/bin/node
do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

# Final fallback: whatever is on PATH. If nothing, fail with a clear error.
if command -v node >/dev/null 2>&1; then
  exec node "$@"
fi

echo "cidrella-node: no usable node binary found (checked bundled runtime and system paths)" >&2
exit 127
