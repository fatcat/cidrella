#!/bin/sh
# cidrella-reset-password: reset a CIDRella user's password from the CLI.
#
# Installed at /usr/local/bin/cidrella-reset-password by install.sh and
# refreshed by update.sh. Mode 0700 root:root, only root can execute it.
# The OS-level root requirement is cosmetic: the real security boundary is
# the 600 mode on /var/lib/cidrella/cidrella.db (v0.4.8+). This wrapper just
# signals intent and hands off to the node script that does the actual work.
#
# Usage:
#   sudo cidrella-reset-password            # resets 'admin'
#   sudo cidrella-reset-password someuser   # resets 'someuser'
#
# The reset script generates a new random password, prints it to stdout,
# marks the account as must_change_password=1, writes an audit_log entry,
# and populates users.password_reset_by so the legitimate account owner
# sees a warning banner on their next successful login. Read the output
# carefully. The new password is shown exactly once and not recoverable.

set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "cidrella-reset-password: must be run as root (use sudo)" >&2
  exit 1
fi

INSTALL_LINK="${INSTALL_LINK:-/opt/cidrella}"
RESET_SCRIPT="$INSTALL_LINK/server/src/reset-password.js"
if [ ! -f "$RESET_SCRIPT" ]; then
  echo "cidrella-reset-password: cannot find $RESET_SCRIPT" >&2
  echo "  Is CIDRella installed at $INSTALL_LINK?" >&2
  exit 1
fi

# Preserve SUDO_USER so the reset script can record who invoked it.
#
# We drop to the cidrella user before running the reset script. Root can
# read/write the DB unconditionally (uid=0 bypasses DAC on Linux without
# needing any capability), so the drop is NOT a security boundary, it's
# a hygiene boundary. If root created any new files via better-sqlite3 (a
# WAL checkpoint, an auto-vacuum artifact), they'd land owned by root:root,
# which later confuses the cidrella service process when it tries to write
# them back. Running as the cidrella user keeps file ownership consistent
# with what the service expects.
#
# CAP_DAC_OVERRIDE is unrelated here. It's the capability that allows a
# *non-root* process to bypass DAC checks. It's redundant for uid=0 and
# stripping it from the cidrella service would not prevent root from
# reading the DB (uid=0 bypasses DAC regardless of capability state).
NODE_BIN="${CIDRELLA_NODE:-/usr/local/bin/cidrella-node}"
if [ ! -x "$NODE_BIN" ]; then
  echo "cidrella-reset-password: $NODE_BIN not found or not executable" >&2
  echo "  This wrapper requires the cidrella-node wrapper (v0.4.3+)." >&2
  exit 1
fi

# Capture SUDO_USER before dropping to cidrella (su -l may strip it)
: "${SUDO_USER:=}"
: "${DATA_DIR:=/var/lib/cidrella}"

# NOTE: do NOT pass CIDRELLA_NODE through to the sudo'd command. NODE_BIN is
# the cidrella-node wrapper, and that wrapper treats $CIDRELLA_NODE as
# "exec this binary instead of resolving", so passing CIDRELLA_NODE pointed
# at cidrella-node makes the wrapper exec itself, in a tight loop, with no
# output. The reset script doesn't need CIDRELLA_NODE in its env anyway;
# the wrapper resolves the bundled runtime on its own.
exec sudo -u cidrella \
  SUDO_USER="$SUDO_USER" \
  DATA_DIR="$DATA_DIR" \
  "$NODE_BIN" "$RESET_SCRIPT" "$@"
