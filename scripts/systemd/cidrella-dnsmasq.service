[Unit]
Description=CIDRella DNSmasq (DNS/DHCP)
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/fatcat/cidrella

[Service]
Type=simple
ExecStartPre=-/usr/bin/pkill -x dnsmasq
ExecStartPre=/usr/bin/touch /var/lib/cidrella/dnsmasq/dnsmasq.log
ExecStartPre=/usr/bin/chgrp cidrella /var/lib/cidrella/dnsmasq/dnsmasq.log
ExecStartPre=-/bin/chmod 0640 /var/lib/cidrella/dnsmasq/dnsmasq.log
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/var/lib/cidrella/dnsmasq/dnsmasq.conf
# ExecReload added in v0.4.11 so the cidrella server can reload dnsmasq via
# `systemctl reload cidrella-dnsmasq` (gated by polkit) instead of going
# through the sudo+setuid `cidrella-dnsmasq-hup` wrapper, which is broken
# under the v0.4.8 NoNewPrivileges-implied hardening on cidrella.service.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

# dnsmasq writes its log as nobody. CIDRella also tails this file for
# Settings > Logging, passive liveness, and metrics, so pre-start repairs
# the existing file to nobody:cidrella 0640. UMask=0027 keeps recreated
# runtime files from becoming world-readable.
UMask=0027

# Capabilities required:
#   CAP_NET_BIND_SERVICE - bind privileged ports 53 (DNS) and 67 (DHCP)
#   CAP_NET_RAW          - ICMP echo checks, DHCP sniffing
#   CAP_NET_ADMIN        - DHCP packet crafting
#   CAP_SETUID/SETGID    - dnsmasq's internal drop-to-nobody at startup
#   CAP_DAC_OVERRIDE     - root-owned dnsmasq process needs to create its
#                          pidfile in /var/lib/cidrella/dnsmasq (owned by
#                          cidrella:cidrella). Without this cap, root is
#                          subject to normal DAC checks and the open()
#                          fails with EACCES. This was learned the hard
#                          way in v0.4.8 hardening testing, the pidfile
#                          create is the canary for this cap.
#   CAP_CHOWN            - chown the pidfile + logfile to 'nobody' so the
#                          dropped process can continue writing them.
#   CAP_KILL             - ExecReload runs /bin/kill -HUP $MAINPID, but
#                          dnsmasq has dropped itself to 'nobody' by then
#                          and ExecReload's process (root inside the unit)
#                          can't signal another UID without CAP_KILL.
#                          Without this, `systemctl reload cidrella-dnsmasq`
#                          fails with "Operation not permitted", which
#                          means every DNS/DHCP config regen since v0.4.11
#                          silently failed to notify the running dnsmasq.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_CHOWN CAP_KILL
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_CHOWN CAP_KILL

# ─── Security hardening (added in v0.4.8) ──────────────
#
# This unit was previously completely unhardened and running as root. A
# release hygiene audit flagged it as the largest single attack-surface
# reduction opportunity in the project. Filesystem sandboxing below gives
# defense-in-depth on top of dnsmasq's own internal drop-to-nobody.
#
# User= is intentionally NOT set. Letting dnsmasq manage its own privilege
# drop (via its built-in --user flag or the `user=` directive in
# dnsmasq.conf) is the well-tested path, setting User=cidrella in systemd
# would cause dnsmasq's internal drop to fail because it already runs as
# a non-root user.
ProtectSystem=strict
# Only the dnsmasq state directory needs to be writable. An earlier draft
# also included /run as a defensive hedge, but testerella validation
# confirmed dnsmasq never writes outside its configured state dir, the
# pidfile, lease file, and logfile all live under /var/lib/cidrella/dnsmasq.
# Keep the writable surface as narrow as possible.
ReadWritePaths=/var/lib/cidrella/dnsmasq
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
NoNewPrivileges=true
RemoveIPC=true

# NOT enabled:
#   PrivateUsers=true: interacts badly with dnsmasq's internal setuid
#   MemoryDenyWriteExecute=true: no JIT but better tested via the
#     dnsmasq upstream before we flip it on
#   RestrictAddressFamilies: dnsmasq needs AF_UNIX, AF_INET, AF_INET6,
#     AF_NETLINK; enabling this without careful testing could break DHCP
#     or DNS-over-TCP. Tracked as a follow-up tightening.

[Install]
WantedBy=multi-user.target
