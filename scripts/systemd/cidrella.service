[Unit]
Description=CIDRella IPAM Server
After=network.target cidrella-dnsmasq.service cidrella-helper.service
Wants=cidrella-dnsmasq.service cidrella-helper.service
# StartLimit* belongs in [Unit], not [Service]. systemd 229+ silently
# ignores these keys when placed under [Service] with an "Unknown key"
# warning, which is where they used to live in this file. Result: the
# flap-loop protection advertised below has never actually been in effect
# on any modern distro. Moved here so it is.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cidrella
Group=cidrella
WorkingDirectory=/opt/cidrella
ExecStart=/usr/local/bin/cidrella-node server/src/launcher.js
Environment=DATA_DIR=/var/lib/cidrella
Environment=NODE_ENV=production
Environment=HTTPS_PORT=8443
Environment=HTTP_PORT=8080
# The DNS proxy runs as cidrella-dns-proxy.service; the web app has systemd
# restart it rather than start one of its own.
Environment=CIDRELLA_DNS_PROXY_SUPERVISOR=systemd
# The privileged helper (cidrella-helper.service) runs the scans' arping and
# ping and every systemctl change; the web app asks it over this socket.
Environment=CIDRELLA_HELPER_SOCKET=/run/cidrella-helper/helper.sock
# Always restart, the service is critical infrastructure. We restart
# on crash (on-failure semantics) AND on deliberate exit (triggered by
# the restore endpoint after a DB file swap). StartLimit* above bounds
# the retry rate so a genuinely-broken startup doesn't flap forever.
Restart=always
RestartSec=5
# The launcher exits 128 + signal, the shell convention, so a clean stop
# by SIGTERM is 143. Without this systemd logs every stop as a failure.
SuccessExitStatus=143

# ─── Security hardening ─────────────────────────────────
#
# Filesystem sandboxing (existing since v0.4.2):
ProtectSystem=strict
ReadWritePaths=/var/lib/cidrella
ProtectHome=true
PrivateTmp=true

# Additional filesystem isolation added in v0.4.8:
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
ProtectClock=true

# Process / behavior restrictions added in v0.4.8:
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true

# Capabilities: bound the service to exactly what it needs, no more.
# CAP_NET_BIND_SERVICE: the web ports when set under 1024 (443, 80), and the
# DHCP probes' client ports (68, 546).
# CAP_NET_RAW: no longer used. The privileged helper runs arping and ping.
# It stays for one release so a rollback to a release that ran them itself
# still scans (rollback.sh does not reinstall units), and goes in the next.
# Do not set file capabilities on the Node binary; file-cap exec clears the
# ambient set.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

# NOTE on NoNewPrivileges: NOT set explicitly, but several directives above
# implicitly set NoNewPrivileges=yes per systemd.exec(5). That is fine for
# current CIDRella: daemon control, updates and NTP go through the privileged
# helper (polkit-gated systemctl over D-Bus), never sudo.
#
# NOT enabled (would break functionality):
#   PrivateUsers=true: creates a user namespace; can interfere with service
#     capabilities and raw sockets in containerized installs.
#   MemoryDenyWriteExecute=true: breaks V8's JIT compiler (Node uses W+X
#     mappings for generated code).
#   SystemCallFilter=@system-service: too broad to adopt blindly; would
#     need a syscall-by-syscall audit against better-sqlite3, duckdb, and
#     scanner child-process execution before turning on. Also implies
#     NoNewPrivileges=yes, which is now fine (see note above), adoption is
#     purely a behavior risk.

[Install]
WantedBy=multi-user.target
