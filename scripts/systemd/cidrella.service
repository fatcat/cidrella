[Unit]
Description=CIDRella IPAM Server
After=network.target cidrella-dnsmasq.service
Wants=cidrella-dnsmasq.service

[Service]
Type=simple
User=cidrella
Group=cidrella
WorkingDirectory=/opt/cidrella
ExecStart=/usr/local/bin/cidrella-node server/src/index.js
Environment=DATA_DIR=/var/lib/cidrella
Environment=NODE_ENV=production
Environment=HTTPS_PORT=8443
Environment=HTTP_PORT=8080
# Always restart — the service is critical infrastructure. We restart
# on crash (on-failure semantics) AND on deliberate exit (triggered by
# the restore endpoint after a DB file swap). StartLimitBurst protects
# against flap loops if the service is genuinely broken on startup.
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Security hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/cidrella
ProtectHome=true
PrivateTmp=true

# Network scanning requires sudo for arping/nmap (NoNewPrivileges must be off)
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
