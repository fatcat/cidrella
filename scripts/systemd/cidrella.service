[Unit]
Description=CIDRella IPAM Server
After=network.target cidrella-dnsmasq.service
Wants=cidrella-dnsmasq.service
# StartLimit* belongs in [Unit], not [Service]. systemd 229+ silently
# ignores these keys when placed under [Service] with an "Unknown key"
# warning — which is where they used to live in this file. Result: the
# flap-loop protection advertised below has never actually been in effect
# on any modern distro. Moved here so it is.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cidrella
Group=cidrella
WorkingDirectory=/opt/cidrella
ExecStart=/usr/local/bin/cidrella-node server/src/index.js
Environment=DATA_DIR=/var/lib/cidrella
Environment=NODE_ENV=production
Environment=HTTPS_PORT=8443
Environment=HTTP_PORT=8080
# Always restart — the service is critical infrastructure. We restart
# on crash (on-failure semantics) AND on deliberate exit (triggered by
# the restore endpoint after a DB file swap). StartLimit* above bounds
# the retry rate so a genuinely-broken startup doesn't flap forever.
Restart=always
RestartSec=5

# ─── Security hardening ─────────────────────────────────
#
# Filesystem sandboxing (existing since v0.4.2):
ProtectSystem=strict
ReadWritePaths=/var/lib/cidrella
ProtectHome=true
PrivateTmp=true

# Additional filesystem isolation added in v0.4.8:
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
ProtectClock=true

# Process / behavior restrictions added in v0.4.8:
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true

# Capabilities: bound the process to exactly what we need, no more.
# CAP_NET_RAW is used by the scanner's raw-socket ICMP pings; CAP_NET_BIND_SERVICE
# lets the process bind privileged ports if needed. CapabilityBoundingSet
# strips every other capability even from the bounding set, so a child
# process can't escalate via any other cap.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

# NOTE on NoNewPrivileges: NOT set explicitly, but seven of the directives
# above (RestrictSUIDSGID, ProtectKernelTunables, ProtectKernelModules,
# ProtectKernelLogs, ProtectClock, PrivateDevices, LockPersonality) each
# implicitly set NoNewPrivileges=yes per systemd.exec(5). This means sudo's
# setuid escalation does NOT work from inside this unit. v0.4.8 / v0.4.9
# shipped with this contradiction unresolved: the in-app updater spawned
# `sudo systemd-run …` and it silently failed. v0.4.11 replaced every such
# callsite with polkit-gated `systemctl` (D-Bus does not need setuid). See
# scripts/polkit/49-cidrella.rules and server/src/routes/version.js. The
# only remaining sudo path is /usr/sbin/arping, scoped narrowly in
# /etc/sudoers.d/cidrella and slated for removal in a follow-up.
#
# NOT enabled (would break functionality):
#   PrivateUsers=true — creates a user namespace; interacts poorly with the
#     bundled Node binary's file capabilities (cap_net_raw, cap_net_bind).
#   MemoryDenyWriteExecute=true — breaks V8's JIT compiler (Node uses W+X
#     mappings for generated code).
#   SystemCallFilter=@system-service — too broad to adopt blindly; would
#     need a syscall-by-syscall audit against better-sqlite3, duckdb, and
#     raw-socket before turning on. Also implies NoNewPrivileges=yes, which
#     is now fine (see note above) — adoption is purely a behavior risk.

[Install]
WantedBy=multi-user.target
