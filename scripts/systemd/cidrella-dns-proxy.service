[Unit]
Description=CIDRella DNS proxy and encrypted forwarder
After=network.target
# Nothing ties it to cidrella.service: DNS keeps answering while the web
# app restarts, updates or stalls. The web app has it restarted when an
# update changed its code (server/src/dns-proxy/code-id.js).
#
# A rollback to a release from before the proxy ran on its own leaves no
# such file; the proxy then exits, this keeps it from starting again, and
# the old web app runs the proxy itself.
ConditionPathExists=/opt/cidrella/server/src/dns-proxy/main.js
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=cidrella
Group=cidrella
WorkingDirectory=/opt/cidrella
ExecStart=/usr/local/bin/cidrella-node server/src/dns-proxy/main.js
Environment=DATA_DIR=/var/lib/cidrella
Environment=NODE_ENV=production
# Always: the web app asks it to exit when its code changed, and the
# watchdog kills it outright when it stops answering. Both expect it back.
Restart=always
RestartSec=1
SuccessExitStatus=143

# The same sandbox as cidrella.service.
ProtectSystem=strict
ReadWritePaths=/var/lib/cidrella
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true

# Port 53 on the LAN addresses, and nothing else.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
