# CIDRella dnsmasq log rotation
#
# Installed to /etc/logrotate.d/cidrella-dnsmasq by scripts/install.sh.
#
# dnsmasq is configured with `log-queries` and `log-dhcp`, which  produces 
# a high-volume append-only log at /var/lib/cidrella/dnsmasq/dnsmasq.log.

/var/lib/cidrella/dnsmasq/dnsmasq.log {
    size 50M
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    dateext
}
