#!/bin/sh
# cidrella-reset-web-ports: recover CIDRella web UI port settings.
#
# Installed at /usr/local/bin/cidrella-reset-web-ports by install.sh and
# refreshed by update.sh. Mode 0700 root:root, only root can execute it.
#
# Usage:
#   sudo cidrella-reset-web-ports
#
# This clears DB overrides for https_port and http_port, re-enables the HTTP
# redirect, then restarts cidrella. The service will fall back to the systemd
# Environment=HTTPS_PORT/HTTP_PORT values installed for this host, or to the
# built-in defaults if no environment override exists.

set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "cidrella-reset-web-ports: must be run as root (use sudo)" >&2
  exit 1
fi

INSTALL_LINK="${INSTALL_LINK:-/opt/cidrella}"
RESET_SCRIPT="$INSTALL_LINK/server/src/reset-web-ports.js"
if [ ! -f "$RESET_SCRIPT" ]; then
  echo "cidrella-reset-web-ports: cannot find $RESET_SCRIPT" >&2
  echo "  Is CIDRella installed at $INSTALL_LINK?" >&2
  exit 1
fi

NODE_BIN="${CIDRELLA_NODE:-/usr/local/bin/cidrella-node}"
if [ ! -x "$NODE_BIN" ]; then
  echo "cidrella-reset-web-ports: $NODE_BIN not found or not executable" >&2
  echo "  This wrapper requires the cidrella-node wrapper (v0.4.3+)." >&2
  exit 1
fi

: "${DATA_DIR:=/var/lib/cidrella}"

sudo -u cidrella \
  DATA_DIR="$DATA_DIR" \
  "$NODE_BIN" "$RESET_SCRIPT"

echo "Restarting cidrella..."
systemctl restart cidrella
echo "CIDRella web ports reset. Check: systemctl status cidrella"
